#!/usr/bin/env bash
# t3ctl: stable entry point for t3-rpc.ts. Uses Node type stripping (Node >= 22.18) or tsx.
set -euo pipefail
script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
entry="$script_dir/t3-rpc.ts"
if node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=18)?0:1)' 2>/dev/null; then
  exec node --no-warnings "$entry" "$@"
elif command -v tsx >/dev/null 2>&1; then
  exec tsx "$entry" "$@"
else
  echo "t3ctl: needs Node >= 22.18 or tsx on PATH" >&2
  exit 127
fi
